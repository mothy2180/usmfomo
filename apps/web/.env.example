# Copy to .env.local. Local values come from `pnpm supabase status -o env`.
# Only the PUBLISHABLE key ever goes here — never an sb_secret_ key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CHANGE_ME
# Cloudflare's always-pass TEST site key for local development.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# proxy = same-origin /i/* Pages Function (production), direct = Supabase URL (vite dev).
VITE_IMAGE_MODE=direct
VITE_CONTACT_URL=
