{
  "name": "usmfomo",
  "private": true,
  "description": "usmfomo \u2014 what's on at USM: club and school events in one place, no sign-up. Unofficial student project.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "account": "node scripts/account.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test:scripts": "node --test scripts/lib/*.test.ts",
    "e2e:functions": "node scripts/lib/e2e/functions-e2e.ts",
    "check": "pnpm -r --if-present run lint && pnpm -r --if-present run typecheck && pnpm typecheck:scripts && pnpm -r --if-present run test && pnpm test:scripts"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mothy2180/usmfomo.git"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@types/node": "26.6.4",
    "supabase": "2.119.0",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
