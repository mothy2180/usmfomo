{
  "name": "usmfomo",
  "private": true,
  "description": "usmfomo — what's on at USM: club and school events in one place, no sign-up. Unofficial student project.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "account": "node scripts/account.ts"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mothy2180/usmfomo.git"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "supabase": "2.119.0",
    "wrangler": "4.146.0"
  }
}
