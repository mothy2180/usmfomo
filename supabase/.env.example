# Copy to supabase/.env (git-ignored). The CLI substitutes env(...) values in
# config.toml from this file. Local/CI use Cloudflare's public always-pass
# Turnstile TEST secret; the production secret lives only in the Supabase
# dashboard (Authentication > Bot and Abuse Protection).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Local-only Edge Function secrets (see [edge_runtime.secrets] in config.toml).
# Production values are generated with `openssl rand -hex 32` and set with
# `pnpm supabase secrets set`; never commit them.
CRON_SECRET=local-dev-cron-secret-not-for-production
ADMIN_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
