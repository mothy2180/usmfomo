{
  "name": "@usmfomo/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./time": "./src/time.ts",
    "./links": "./src/links.ts",
    "./images": "./src/images.ts",
    "./errors": "./src/errors.ts",
    "./ics": "./src/ics.ts",
    "./schemas": "./src/schemas.ts",
    "./supabase": "./src/supabase.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --local --schema public > src/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "5.0.3"
  },
  "sideEffects": [
    "./src/schemas.ts",
    "./src/index.ts"
  ]
